#!/usr/bin/env bash
# Compile and upload the water level sketch to an Arduino Uno with the project's own toolchain.
#   scripts/setup/upload [port] [extra -D flags...]
#   e.g. scripts/setup/upload /dev/ttyACM0
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
acli="$root/scripts/setup/acli"
sketch="$root/firmware/level_controller"
[ "${1:-}" = "level" ] && shift          # the older form: upload level [port]
port=""
case "${1:-}" in -*|"") ;; *) port="$1"; shift ;; esac   # no port given: auto-detect
if [ -z "$port" ]; then
  port="$("$acli" board list | awk '/arduino:avr:uno/ {print $1; exit}')"
  # clone Unos with a CH340 USB chip report "Unknown": fall back to the first USB serial port
  [ -n "$port" ] || port="$(ls /dev/ttyACM* /dev/ttyUSB* 2>/dev/null | head -1)"
  [ -n "$port" ] || { echo "No Uno found. Plug it in or give the port (e.g. /dev/ttyACM0)."; "$acli" board list; exit 1; }
fi
rev="$(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo nogit)"
[ -z "$(git -C "$root" status --porcelain --untracked-files=no 2>/dev/null)" ] || rev="$rev-dirty"
flags="-DFW_REV=\"$rev\" $*"
echo "Sketch $sketch -> $port  (FW_REV $rev)"
"$acli" compile --fqbn arduino:avr:uno --build-property "compiler.cpp.extra_flags=$flags" --upload --port "$port" "$sketch"
